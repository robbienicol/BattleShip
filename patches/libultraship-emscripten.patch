 #include "ship/config/ConsoleVariable.h"
 #include "ship/Context.h"
 
+namespace {
+// Runs a loading task on the pool, or — in the browser build, which has no
+// threads — right away, returning an already-completed future.
+template <typename F>
+auto RunOrSubmit(std::shared_ptr<BS::thread_pool>& pool, F&& task, BS::priority_t priority = 0)
+    -> std::shared_future<decltype(task())> {
+#if defined(__EMSCRIPTEN__)
+    (void)pool;
+    (void)priority;
+    using Result = decltype(task());
+    std::promise<Result> promise;
+    if constexpr (std::is_void_v<Result>) {
+        task();
+        promise.set_value();
+    } else {
+        promise.set_value(task());
+    }
+    return promise.get_future().share();
+#else
+    return pool->submit_task(std::forward<F>(task), priority);
+#endif
+}
+} // namespace
+
